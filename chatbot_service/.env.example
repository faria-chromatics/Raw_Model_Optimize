# Copy this file to .env and fill in values for local development.
# All settings have sensible defaults — only override what you need.

# API
APP_TITLE=Chatbot Service
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
# Keep at 1. GPU VRAM cannot be shared across worker processes.
API_WORKERS=1

# Environment: dev | prod
ENV=dev

# Model: mock | real
# mock  — no model files needed, instant startup
# real  — loads Qwen3-4B base + LoRA adapter from MODEL_PATH
MODEL_MODE=mock
MODEL_PATH=/models/adapter
BASE_MODEL_NAME=Qwen/Qwen3-4B

# Generation
MAX_NEW_TOKENS=512
TEMPERATURE=0.3
DO_SAMPLE=true

# Logging
LOG_LEVEL=INFO
# text — human-readable (dev)
# json — structured for log aggregation (prod)
LOG_FORMAT=text
